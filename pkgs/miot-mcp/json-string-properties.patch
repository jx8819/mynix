diff --git a/tests/test_json_string_properties.py b/tests/test_json_string_properties.py
new file mode 100644
index 0000000..834238b
--- /dev/null
+++ b/tests/test_json_string_properties.py
@@ -0,0 +1,127 @@
+"""Exercise FastMCP argument parsing through the adapter and real MIOT validation."""
+import json
+import unittest
+from unittest.mock import Mock
+
+from mcp.server.fastmcp.utilities.func_metadata import func_metadata
+from mijiaAPI.devices import DevProp, mijiaDevice
+
+from adapter.mijia_adapter import MijiaAdapter
+
+
+class JsonStringPropertyTests(unittest.IsolatedAsyncioTestCase):
+    def setUp(self):
+        # Bypass discovery/login, but retain the SDK's actual property setter.
+        self.api = Mock(spec=["set_devices_prop"])
+        self.api.set_devices_prop.return_value = {"code": 0}
+        self.device = mijiaDevice.__new__(mijiaDevice)
+        self.device.api = self.api
+        self.device.did = "fixture-camera"
+        self.device.name = "Fixture camera"
+        self.device.sleep_time = 0
+        self.device.prop_list = {}
+        for name, prop_type, piid in [
+            ("enable-time-period", "string", 2),
+            ("enabled", "bool", 4),
+            ("sensitivity", "uint", 5),
+            ("threshold", "float", 6),
+        ]:
+            prop = DevProp({
+                "name": name,
+                "description": name,
+                "type": prop_type,
+                "rw": "rw",
+                "range": None,
+                "method": {"siid": 24, "piid": piid},
+            })
+            self.device.prop_list[name] = prop
+            self.device.prop_list[name.replace("-", "_")] = prop
+        self.adapter = MijiaAdapter.__new__(MijiaAdapter)
+        self.adapter._connected = True
+        self.adapter._devices = {self.device.did: self.device}
+        self.metadata = func_metadata(self.adapter.set_property_value_by_name)
+
+    async def call_through_fastmcp(self, value, property_name="enable-time-period"):
+        return await self.metadata.call_fn_with_arg_validation(
+            self.adapter.set_property_value_by_name,
+            fn_is_async=True,
+            arguments_to_validate={
+                "device_id": self.device.did,
+                "property_name": property_name,
+                "value": value,
+            },
+            arguments_to_pass_directly=None,
+        )
+
+    async def test_json_object_text_reaches_miot_without_outer_quotes(self):
+        text = '{"start_time":"22:30","end_time":"07:00"}'
+        self.assertIsInstance(self.metadata.pre_parse_json({"value": text})["value"], dict)
+        self.assertTrue(await self.call_through_fastmcp(text))
+        self.api.set_devices_prop.assert_called_once_with({
+            "did": self.device.did,
+            "siid": 24,
+            "piid": 2,
+            "value": text,
+        })
+        # Decoding once must yield an object, not another quoted JSON string.
+        self.assertEqual(json.loads(self.api.set_devices_prop.call_args.args[0]["value"]), {
+            "start_time": "22:30", "end_time": "07:00",
+        })
+
+    async def test_json_array_and_object_values_use_string_property_metadata(self):
+        for value, expected in [
+            ('["夜间",{"enabled":true}]', '["夜间",{"enabled":true}]'),
+            ({"start_time": "22:30", "end_time": "07:00"},
+             '{"start_time":"22:30","end_time":"07:00"}'),
+            (["night", {"enabled": False}], '["night",{"enabled":false}]'),
+        ]:
+            with self.subTest(value=value):
+                self.api.set_devices_prop.reset_mock()
+                await self.call_through_fastmcp(value, "enable_time_period")
+                self.assertEqual(self.api.set_devices_prop.call_args.args[0]["value"], expected)
+
+    async def test_existing_strings_are_not_encoded_again(self):
+        for value in ["night", "", "123", "true", '{ "start_time": "22:30" }']:
+            with self.subTest(value=value):
+                self.api.set_devices_prop.reset_mock()
+                await self.adapter.set_property_value_by_name(
+                    self.device.did, "enable-time-period", value,
+                )
+                self.assertEqual(self.api.set_devices_prop.call_args.args[0]["value"], value)
+
+    async def test_invalid_string_scalars_still_fail_sdk_validation(self):
+        for value in [None, True, 123, 1.5]:
+            with self.subTest(value=value):
+                self.api.set_devices_prop.reset_mock()
+                with self.assertRaises(ValueError):
+                    await self.adapter.set_property_value_by_name(
+                        self.device.did, "enable-time-period", value,
+                    )
+                self.api.set_devices_prop.assert_not_called()
+
+    async def test_non_string_properties_retain_sdk_coercion(self):
+        for name, value, expected in [
+            ("enabled", False, False),
+            ("enabled", "true", True),
+            ("sensitivity", "2", 2),
+            ("threshold", "1.5", 1.5),
+        ]:
+            with self.subTest(name=name, value=value):
+                self.api.set_devices_prop.reset_mock()
+                await self.call_through_fastmcp(value, name)
+                actual = self.api.set_devices_prop.call_args.args[0]["value"]
+                self.assertEqual(actual, expected)
+                self.assertIs(type(actual), type(expected))
+
+    async def test_structured_values_remain_invalid_for_non_string_properties(self):
+        for name in ["enabled", "sensitivity", "threshold"]:
+            for value in [{"enabled": True}, [1, 2]]:
+                with self.subTest(name=name, value=value):
+                    self.api.set_devices_prop.reset_mock()
+                    with self.assertRaises((TypeError, ValueError)):
+                        await self.call_through_fastmcp(value, name)
+                    self.api.set_devices_prop.assert_not_called()
+
+
+if __name__ == "__main__":
+    unittest.main()
