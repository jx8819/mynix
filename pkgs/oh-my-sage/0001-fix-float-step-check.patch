+/** step 对齐检查。浮点 step（如 0.1）下整数取模会把合法值判为不齐——(27 - (-30)) % 0.1 === 0.0999… !== 0，
+ *  任何温度阈值都过不了校验；改用「除以 step 后的商是否接近整数」判断，容差 1e-6 步。 */
+function withinStep(value: number, range: { min: number; max: number; step: number }): boolean {
+    if (!Number.isFinite(range.step) || range.step <= 0) return true;
+    const steps = (value - range.min) / range.step;
+    return Math.abs(steps - Math.round(steps)) <= 1e-6;
+}
